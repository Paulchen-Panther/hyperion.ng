set(PROJECT_NAME "@PROJECT_NAME@")
set(QMAKE_EXECUTABLE "@QMAKE_EXECUTABLE@")
set(OPENSSL_FOUND @OPENSSL_FOUND@)
set(OPENSSL_LIBRARIES "@OPENSSL_LIBRARIES@")
set(PYTHON_MODULES_DIR "@PYTHON_MODULES_DIR@")
set(PYTHON_VERSION "@PYTHON_VERSION@")
set(CMAKE_BINARY_DIR "@CMAKE_BINARY_DIR@")

string(CONCAT SYSTEM_LIBS_SKIP
    "libatomic|libc|libdbus-1|libdl|libexpat|libfontconfig|libgcc_s|"
    "libgcrypt|libglib-2\\.0|libgpg-error|liblz4|liblzma|libm|libpcre|"
    "libpcre2-[0-9]+|libpthread|librt|libstdc\\+\\+|libsystemd|libudev|"
    "libusb-1\\.0|libutil|libuuid|libz|ld-linux[a-z0-9_-]*"
)

# Get Qt plugin path
execute_process(
	COMMAND "${QMAKE_EXECUTABLE}" -query QT_INSTALL_PLUGINS
	OUTPUT_VARIABLE QT_PLUGINS_DIR
	OUTPUT_STRIP_TRAILING_WHITESPACE
)

set(PREREQUISITE_LIBS "")
foreach(PLUGIN "platforms" "sqldrivers" "imageformats" "tls" "wayland-shell-integration")
	file(GLOB PLUGIN_FILES "${QT_PLUGINS_DIR}/${PLUGIN}/*.so")
	if(PLUGIN_FILES)
		file(INSTALL ${PLUGIN_FILES}
			DESTINATION "${CMAKE_INSTALL_PREFIX}/share/hyperion/lib/${PLUGIN}"
			TYPE SHARED_LIBRARY
			FOLLOW_SYMLINK_CHAIN
		)
		list(APPEND PREREQUISITE_LIBS ${PLUGIN_FILES})
	endif()
endforeach()

# Install OpenSSL and append it to PREREQUISITE_LIBS
if(OPENSSL_FOUND)
	file(INSTALL ${OPENSSL_LIBRARIES}
		DESTINATION "${CMAKE_INSTALL_PREFIX}/share/hyperion/lib"
		TYPE SHARED_LIBRARY
		FOLLOW_SYMLINK_CHAIN
	)
	list(APPEND PREREQUISITE_LIBS ${OPENSSL_LIBRARIES})
endif()

# Find the dependencies of the executable, the Qt plugins and OpenSSL
list(REMOVE_DUPLICATES PREREQUISITE_LIBS)
file(GET_RUNTIME_DEPENDENCIES
	EXECUTABLES "${CMAKE_BINARY_DIR}/bin/${PROJECT_NAME}"
	LIBRARIES ${PREREQUISITE_LIBS}
	PRE_EXCLUDE_REGEXES "^(${SYSTEM_LIBS_SKIP})\\.so"
	RESOLVED_DEPENDENCIES_VAR DEPS
	UNRESOLVED_DEPENDENCIES_VAR DEPS_UNRESOLVED
)

foreach(dep ${DEPS_UNRESOLVED})
	message(ERROR "Runtime dependency ${dep} could not be resolved.")
endforeach()

# Copy dependencies with their symlink chains
list(REMOVE_DUPLICATES DEPS)
file(INSTALL ${DEPS}
	DESTINATION "${CMAKE_INSTALL_PREFIX}/share/hyperion/lib"
	TYPE SHARED_LIBRARY
	FOLLOW_SYMLINK_CHAIN
)

# Create a qt.conf file in 'share/hyperion/bin' to override hard-coded search paths in Qt plugins
file(WRITE "${CMAKE_BINARY_DIR}/qt.conf" "[Paths]\nPlugins=../lib/\n")
file(INSTALL "${CMAKE_BINARY_DIR}/qt.conf"
	DESTINATION "${CMAKE_INSTALL_PREFIX}/share/hyperion/bin"
)

# Copy Python modules to 'share/hyperion/lib/pythonMAJOR.MINOR' and ignore the unnecessary stuff listed below
if(NOT PYTHON_MODULES_DIR STREQUAL "" AND NOT PYTHON_VERSION STREQUAL "")
	string(REGEX MATCH "^[0-9]+\\.[0-9]+" PYTHON_MAJOR_MINOR "${PYTHON_VERSION}")
	file(INSTALL ${PYTHON_MODULES_DIR}/
		DESTINATION "${CMAKE_INSTALL_PREFIX}/share/hyperion/lib/python${PYTHON_MAJOR_MINOR}"
		PATTERN "*.pyc"                           EXCLUDE # compiled bytecodes
		PATTERN "__pycache__"                     EXCLUDE # any cache
		PATTERN "config-${PYTHON_MAJOR_MINOR}*"   EXCLUDE # static libs
		PATTERN "lib2to3"                         EXCLUDE # automated Python 2 to 3 code translation
		PATTERN "tkinter"                         EXCLUDE # Tk interface
		PATTERN "lib-dynload/_tkinter.*"          EXCLUDE
		PATTERN "idlelib"                         EXCLUDE
		PATTERN "turtle.py"                       EXCLUDE # Tk demo
		PATTERN "test"                            EXCLUDE # unittest module
		PATTERN "sitecustomize.py"                EXCLUDE # site-specific configs
	)
endif()
